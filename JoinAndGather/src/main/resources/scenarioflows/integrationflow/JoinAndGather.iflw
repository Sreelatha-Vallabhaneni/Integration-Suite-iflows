                    <value>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;School&gt;
  &lt;SchoolName&gt;Greenwood International School&lt;/SchoolName&gt;
  &lt;AcademicYear&gt;2024-2025&lt;/AcademicYear&gt;

  &lt;Students&gt;

    &lt;Student&gt;
      &lt;StudentID&gt;STU-001&lt;/StudentID&gt;
      &lt;FirstName&gt;Arjun&lt;/FirstName&gt;
      &lt;LastName&gt;Sharma&lt;/LastName&gt;
      &lt;DateOfBirth&gt;2010-06-15&lt;/DateOfBirth&gt;
      &lt;Grade&gt;10&lt;/Grade&gt;
      &lt;Section&gt;A&lt;/Section&gt;
    &lt;/Student&gt;

    &lt;Student&gt;
      &lt;StudentID&gt;STU-002&lt;/StudentID&gt;
      &lt;FirstName&gt;Priya&lt;/FirstName&gt;
      &lt;LastName&gt;Reddy&lt;/LastName&gt;
      &lt;DateOfBirth&gt;2011-03-22&lt;/DateOfBirth&gt;
      &lt;Grade&gt;9&lt;/Grade&gt;
      &lt;Section&gt;B&lt;/Section&gt;
    &lt;/Student&gt;

    &lt;Student&gt;
      &lt;StudentID&gt;STU-003&lt;/StudentID&gt;
      &lt;FirstName&gt;Mohammed&lt;/FirstName&gt;
      &lt;LastName&gt;Khan&lt;/LastName&gt;
      &lt;DateOfBirth&gt;2009-11-08&lt;/DateOfBirth&gt;
      &lt;Grade&gt;10&lt;/Grade&gt;
      &lt;Section&gt;C&lt;/Section&gt;
    &lt;/Student&gt;

  &lt;/Students&gt;

&lt;/School&gt;</value>
