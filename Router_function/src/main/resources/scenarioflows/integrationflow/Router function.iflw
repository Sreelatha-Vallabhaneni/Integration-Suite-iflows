                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;Orders&gt;
	&lt;Order&gt;
		&lt;OrderID&gt;ORD-2024-001&lt;/OrderID&gt;
		&lt;OrderDate&gt;2024-04-23&lt;/OrderDate&gt;
		&lt;Status&gt;Confirmed&lt;/Status&gt;
		&lt;Customer&gt;
			&lt;CustomerID&gt;CUST-101&lt;/CustomerID&gt;
			&lt;Name&gt;John Smith&lt;/Name&gt;
			&lt;Email&gt;john.smith@example.com&lt;/Email&gt;
		&lt;/Customer&gt;
		&lt;OrderValue&gt;
			&lt;SubTotal&gt;115&lt;/SubTotal&gt;
			&lt;Tax&gt;10&lt;/Tax&gt;
			&lt;Discount&gt;5&lt;/Discount&gt;
			&lt;TotalOrderValue&gt;120&lt;/TotalOrderValue&gt;
			&lt;Currency&gt;USD&lt;/Currency&gt;
		&lt;/OrderValue&gt;
		&lt;Item&gt;
			&lt;ItemID&gt;ITEM-001&lt;/ItemID&gt;
			&lt;ProductName&gt;Wireless Keyboard&lt;/ProductName&gt;
			&lt;Quantity&gt;2&lt;/Quantity&gt;
			&lt;UnitPrice&gt;45&lt;/UnitPrice&gt;
			&lt;TotalPrice&gt;90&lt;/TotalPrice&gt;
		&lt;/Item&gt;
	&lt;/Order&gt;
&lt;/Orders&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Enricher/version::1.6.5</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_5</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_8</bpmn2:outgoing>
        </bpmn2:callActivity>
